<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AndrisCom - Telecommunications</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
        }
        .hero {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #eae8e4;
            overflow: hidden;
        }
        .hero img {
            max-width: 40%;
            height: auto;
        }
        .cta-button {
            position: absolute;
            bottom: 10%;
            padding: 15px 30px;
            font-size: 20px;
            font-weight: bold;
            background-color: #4a7b6e;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.3s ease, background-color 0.3s ease;
        }
        .cta-button:hover {
            transform: scale(1.1);
            background-color: #3a5f52;
        }
        .services {
            padding: 50px 20px;
            background-color: white;
        }
        .services h2 {
            font-size: 28px;
            color: #4a7b6e;
            margin-bottom: 20px;
        }
        .service-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        .service-box {
            background-color: #eae8e4;
            padding: 20px;
            border-radius: 10px;
            width: 250px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .service-box h3 {
            color: #4a7b6e;
            margin-bottom: 10px;
        }
        .team {
            padding: 50px 20px;
            background-color: #f4f4f4;
        }
        .team h2 {
            font-size: 28px;
            color: #4a7b6e;
            margin-bottom: 20px;
        }
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            justify-items: center;
        }
        .team-member {
            background-color: #eae8e4;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .team-member img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin-bottom: 10px;
        }
        .team-member h3 {
            color: #4a7b6e;
        }

        /* Beúszó szöveg animáció */
        .scrolling-text {
            position: absolute;
            top: 10%;
            left: -100%;
            font-size: 30px;
            font-weight: bold;
            color: #4a7b6e;
            white-space: nowrap;
            animation: scroll-text 15s linear infinite;
        }

        @keyframes scroll-text {
            0% {
                left: -100%;
            }
            100% {
                left: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="hero">
        <img src="logo.png" alt="AndrisCom Logo">
        <button class="cta-button">Fedezd fel</button>
        <!-- Beúszó szöveg -->
        <div class="scrolling-text">Üdvözlünk az AndrisCom-on!</div>
    </div>
    
    <section class="services">
        <h2>Szolgáltatásaink</h2>
        <div class="service-container">
            <div class="service-box">
                <h3>Mobilkommunikáció</h3>
                <p>Gyors és megbízható mobilhálózat.</p>
            </div>
            <div class="service-box">
                <h3>Internet Szolgáltatás</h3>
                <p>Stabil és gyors internet otthonra és vállalkozásoknak.</p>
            </div>
            <div class="service-box">
                <h3>Ügyfélszolgálat</h3>
                <p>24/7 támogatás minden ügyfelünknek.</p>
            </div>
        </div>
    </section>

    <section class="team">
        <h2>Csapatunk</h2>
        <div class="team-grid">
            <div class="team-member">
                <img src="ceo.png" alt="CEO">
                <h3>Andrés García</h3>
                <p>Vezérigazgató</p>
            </div>
            <div class="team-member">
                <img src="marketing.png" alt="Marketing Director">
                <h3>Elisabeth Nordström</h3>
                <p>Marketing Igazgató</p>
            </div>
            <div class="team-member">
                <img src="tech.png" alt="CTO">
                <h3>Péter Kovács</h3>
                <p>Technológiai Igazgató</p>
            </div>
        </div>
    </section>
</body>
</html>
